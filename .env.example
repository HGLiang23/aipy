AIPY_ENVIRONMENT=local
AIPY_DEBUG=false
AIPY_LOG_LEVEL=INFO
AIPY_API__HOST=0.0.0.0
AIPY_API__PORT=8000
AIPY_DATABASE__URL=postgresql+psycopg://aipy:aipy@localhost:5432/aipy
AIPY_REDIS__URL=redis://localhost:6379/0
AIPY_CELERY__BROKER_URL=redis://localhost:6379/1

# Signing key for access/refresh tokens. At least 32 characters.
# Required whenever AIPY_ENVIRONMENT is staging or production: the app refuses
# to start rather than fall back to the well-known development key.
AIPY_JWT__SECRET_KEY=change-me-to-a-random-string-of-32-chars-or-more
AIPY_JWT__ISSUER=aipy
AIPY_JWT__AUDIENCE=aipy
