# Copy to deploy/.env for local use. Values below are examples, not production secrets.
POSTGRES_DB=aipy
POSTGRES_USER=aipy
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
AIPY_RUNTIME_USER=aipy_runtime
AIPY_RUNTIME_PASSWORD=replace-with-a-separate-runtime-password

REDIS_PORT=6379

MINIO_ROOT_USER=aipy-local
MINIO_ROOT_PASSWORD=replace-with-a-long-local-password
MINIO_BUCKET=aipy
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_CLIENT_IMAGE=minio/mc:RELEASE.2025-04-16T18-13-26Z

API_PORT=8000
AIPY_APP_NAME=AIPY API
AIPY_ENVIRONMENT=local
AIPY_DEBUG=false
AIPY_LOG_LEVEL=INFO
